#%rec:emFpPlugin%#

FileTypes = { ".dia" }
FileFormatName = "Dia"
Priority = 0.5
Library = "emTmpConv"
Function = "emTmpConvFpPluginFunc"
Properties = {
 {
  Name="OutFileEnding"
  Value=".svg"
 }
 {
  Name="Command"
  Value="dia \"--export=$OUTFILE\" --filter=svg \"$INFILE\" < /dev/null > /dev/null"
 }
}
